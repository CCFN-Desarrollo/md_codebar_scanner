#!/usr/bin/env bash
# Recibe por stdin el APK o el archivo de version de md_codebar_scanner y lo
# publica en sap10. Se instala en el EC2 como ~ec2-user/bin/md-scanner-recibir y
# es lo UNICO que puede ejecutar la llave de despliegue (ver docs/CD.md):
#
#   restrict,command="/home/ec2-user/bin/md-scanner-recibir" ssh-ed25519 AAAA... md-scanner-deploy
#
# Uso (desde GitHub Actions):
#   ssh ec2-user@servidor apk     < app-release.apk
#   printf '2.0.2' | ssh ec2-user@servidor version
#
# Cada archivo se escribe primero en un temporal de la misma carpeta y luego se
# renombra (mv atomico): un equipo nunca descarga un archivo a medias.
set -euo pipefail

DEST="/var/www/html/CCFNCRM/public/sap10"
APK="md_codebar_scanner.apk"
VERSION_FILE="MD_CODEBAR_SCANNER_VERSION.text"
MAX_BYTES=$((300 * 1024 * 1024))

accion="${SSH_ORIGINAL_COMMAND:-${1:-}}"

case "$accion" in
  apk) final="$APK" ;;
  version) final="$VERSION_FILE" ;;
  *)
    echo "uso: apk | version (contenido por stdin)" >&2
    exit 2
    ;;
esac

tmp="$(mktemp "$DEST/.${final}.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

# Lee como maximo MAX_BYTES + 1 para detectar archivos demasiado grandes.
head -c $((MAX_BYTES + 1)) > "$tmp"
size="$(stat -c %s "$tmp")"

if [ "$accion" = "apk" ]; then
  if [ "$size" -gt "$MAX_BYTES" ]; then
    echo "APK rechazado: excede $MAX_BYTES bytes" >&2
    exit 1
  fi
  if [ "$size" -lt 1048576 ] || [ "$(head -c 2 "$tmp")" != "PK" ]; then
    echo "APK rechazado: no parece un APK valido ($size bytes)" >&2
    exit 1
  fi
  # Respaldo del APK anterior para poder regresar de version a mano.
  if [ -f "$DEST/$APK" ]; then
    cp -p "$DEST/$APK" "$DEST/.${APK}.anterior"
  fi
else
  version="$(tr -d ' \r\n\t' < "$tmp")"
  if ! [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Version rechazada: '$version' no tiene formato X.Y.Z" >&2
    exit 1
  fi
  # Sin salto de linea al final (lo espera app_update_service.dart).
  printf '%s' "$version" > "$tmp"
fi

chmod 644 "$tmp"
mv -f "$tmp" "$DEST/$final"
trap - EXIT
echo "ok: $final ($(stat -c %s "$DEST/$final") bytes)"
